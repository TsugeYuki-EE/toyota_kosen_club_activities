# Toyota Kosen Club Activities - Environment Variables Example
# このファイルを .env にコピーして、値を設定してください。

# === Cloudflare Tunnel ===
# Cloudflare Tunnel用のトークン（ドメイン公開時に必要）
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# アプリの公開URL（Cloudflare Tunnel経由でアクセスするドメイン）
PUBLIC_BASE_URL=https://your-domain.example.com

# HTTPS強制を有効化
FORCE_HTTPS=true

# DBマイグレーションを有効化（初回デプロイ時にtrue）
RUN_DB_MIGRATIONS=true

# === PostgreSQL ===
POSTGRES_USER=club
POSTGRES_PASSWORD=change-this-to-a-secure-password

# === 管理画面用キー ===
HANDBALL_ADMIN_VIEW_KEY=change-this-to-a-random-string
TABLE_TENNIS_ADMIN_VIEW_KEY=change-this-to-a-random-string

# === 部活パスワード ===
HANDBALL_CLUB_PASSWORD=change-this-password
TABLE_TENNIS_CLUB_PASSWORD=change-this-password

# === スーパー管理者ログイン用パスワード ===
HANDBALL_SUPER_ADMIN_NICKNAME=admin
HANDBALL_SUPER_ADMIN_LOGIN_PASSWORD=change-this-password
TABLE_TENNIS_SUPER_ADMIN_NICKNAME=admin
TABLE_TENNIS_SUPER_ADMIN_LOGIN_PASSWORD=change-this-password

# === LINE Messaging API（卓球のみ）===
# 卓球の試合結果通知などに使用（オプション）
TABLE_TENNIS_LINE_MESSAGING_API_CHANNEL_ACCESS_TOKEN=
TABLE_TENNIS_LINE_MESSAGING_API_TARGET_ID=

# === メール通知（オプション）===
# 出席リマインダーなどに使用
ATTENDANCE_REMINDER_EMAIL_API_KEY=
ATTENDANCE_REMINDER_EMAIL_FROM=
RESEND_API_KEY=
EMAIL_FROM=